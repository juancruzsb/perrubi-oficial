# Copiar a .env y completar con valores reales. Nunca commitear .env.

# Cadena de conexión de Postgres (Neon)
DATABASE_URL=

# Puerto en el que escucha el servidor Express
PORT=3000

# Secreto para firmar los JWT de auth
JWT_SECRET=

# API key de Google Maps/Places/Routes (usada por maps.service.js)
API_KEY_MAPS=

# URL del microservicio de IA (Perrubi- Parte IA, FastAPI: matching,
# recomendaciones y cálculos de reseñas). Local por defecto: uvicorn corriendo
# con `python -m uvicorn api:app --port 8000` en ese repo.
IA_API_URL=http://127.0.0.1:8000
