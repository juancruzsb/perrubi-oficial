# Copiar a .env y completar con valores reales. Nunca commitear .env.

# Cadena de conexión de Postgres (Neon)
DATABASE_URL=

# Puerto en el que escucha el servidor Express
PORT=3000

# Secreto para firmar los JWT de auth
JWT_SECRET=

# API key de Google Maps/Places/Routes (usada por maps.service.js)
API_KEY_MAPS=

# API key de Google Maps JavaScript API (la usa GET /maps/embed para el mapa
# interactivo). Va visible en el HTML de la página: restringirla en GCP a
# "Maps JavaScript API" y, en producción, por HTTP referrer.
API_KEY_MAPS_JS=
